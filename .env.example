# Copier vers .env (à la racine) : cp .env.example .env
# Ne JAMAIS committer .env.

# --- Application ---
ENVIRONMENT=development          # development | test | production
# Générer : python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-.env-before-any-real-use
ACCESS_TOKEN_MINUTES=60
AUTH_RATE_LIMIT_PER_MINUTE=10
CORS_ORIGINS=http://localhost:3000

# --- Base de données ---
# Développement : SQLite. Production future : PostgreSQL, ex.
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/predix
DATABASE_URL=sqlite:///./data/predix.db

# --- Mode de données : manual | demo | api ---
DATA_MODE=manual

# --- Fournisseurs externes (désactivés tant que la clé est vide) ---
API_FOOTBALL_KEY=
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
ODDS_API_KEY=
ODDS_API_BASE_URL=https://api.the-odds-api.com/v4

# --- Assistant : modèle de langage (optionnel, non branché à ce stade) ---
LLM_PROVIDER=
LLM_API_KEY=
